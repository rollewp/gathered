{
  "name": "gathered",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:eval && npm run test:recommendations && npm run test:journey1 && npm run test:catalog && npm run test:profile && npm run test:schedule",
    "test:eval": "node scripts/test_eval_metrics.mjs && node scripts/test_rank_contract.mjs && node scripts/test_schedule_contract.mjs",
    "test:schedule": "node --import tsx --conditions=react-server --env-file=.env.local scripts/test_schedule_review.mjs",
    "test:profile": "node --import tsx --conditions=react-server --env-file=.env.local scripts/test_profile.mjs",
    "test:catalog": "node --import tsx --conditions=react-server --env-file=.env.local scripts/test_catalog.mjs",
    "test:journey1": "node --import tsx --conditions=react-server --env-file=.env.local scripts/test_journey1.mjs",
    "test:recommendations": "node --import tsx --conditions=react-server --env-file=.env.local scripts/test_recommendations.mjs",
    "verify:journey1": "node --import tsx --conditions=react-server --env-file=.env.local scripts/verify_journey1.mjs",
    "smoke:manager": "node --env-file=.env.local scripts/smoke_manager_review.mjs",
    "smoke:profile": "node --env-file=.env.local scripts/smoke_profile.mjs",
    "smoke:journey1": "node --env-file=.env.local scripts/smoke_journey1.mjs",
    "verify:openrouter": "node --import tsx --conditions=react-server --env-file=.env.local scripts/verify_openrouter.mjs",
    "features:local": "node --env-file=.env.local scripts/compute_person_features.mjs",
    "seed:generate": "python seed/generate_seed.py",
    "seed:validate": "node scripts/seed_validate.mjs",
    "seed:check": "node scripts/seed_validate.mjs --determinism",
    "seed:reset": "node --env-file=.env.local scripts/load_seed.mjs && node --env-file=.env.local scripts/compute_person_features.mjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.4.3",
    "openai": "^7.51.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "react": "^19",
    "react-dom": "^19",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}

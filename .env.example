# Gathered: template. Copy to .env.local and fill in. Safe to commit (no values).
# Node 20+: run scripts with  node --env-file=.env.local <script>

# --- Lakebase Postgres (project gathered-demo) ---
# App role: LOGIN only, row-level security applies. The ONLY role the app uses.
DATABASE_URL=postgresql://gathered_app:<password>@<host>:5432/databricks_postgres?sslmode=require
# Owner role: migrations and seed loads only. Never used by the running app.
DATABASE_OWNER_URL=postgresql://<owner>:<password>@<host>:5432/databricks_postgres?sslmode=require

# --- Demo access gate (server-side only; never NEXT_PUBLIC_*) ---
# The shared password for the deployed demo. Required in production (the app fails closed without it);
# in `npm run dev` an unset value leaves the gate open. Set the real value here and in Vercel; do not commit it.
DEMO_PASSWORD=

# --- OpenRouter (server-side only, never exposed to the browser) ---
OPENROUTER_API_KEY=
# Model IDs: copy exact IDs from openrouter.ai/models
# Claude Haiku: intake + final ranking
OPENROUTER_MODEL_FAST=
# Claude Sonnet: escalation review
OPENROUTER_MODEL_REVIEW=

# --- Databricks (Free Edition) ---
# Auth comes from the CLI profile (`databricks auth login`), not a token in this file.
DATABRICKS_HOST=https://YOUR-WORKSPACE.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=

# Scoped role used by the Databricks refresh job (password set in the Lakebase console; local verification only)
DATABASE_REFRESH_URL=postgresql://gathered_refresh:<password>@<host>:5432/databricks_postgres?sslmode=require
